# Neon Postgres connection string (serverless / pooled).
# Lấy từ Neon dashboard -> Connection Details -> "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Secret bảo vệ /api/cron. Tạo chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 32
# External cron phải gửi kèm header:  x-cron-secret: <chuỗi này>
CRON_SECRET=replace-with-a-long-random-secret
